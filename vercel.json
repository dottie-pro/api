{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/cron/check-new-users",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/cron/check-trials",
      "schedule": "0 0 * * *"
    }
  ]
}
